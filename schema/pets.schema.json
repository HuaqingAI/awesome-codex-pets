{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huaqingai/awesome-codex-pets/schema/pets.schema.json",
  "title": "Awesome Codex Pets Catalog",
  "type": "object",
  "required": [
    "version",
    "packageName",
    "repository",
    "rawBaseUrl",
    "categories",
    "pets"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "packageName": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "rawBaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "previewStates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "pets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pet"
      }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "pet": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "author": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "packagePath": {
          "type": "string"
        },
        "previewPath": {
          "type": "string"
        },
        "previewStates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
