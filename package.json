{
  "name": "awesome-codex-pets",
  "version": "0.3.0",
  "description": "Ready-to-install Codex desktop pets plus catalog, preview, and installer tooling.",
  "type": "module",
  "bin": {
    "awesome-codex-pets": "./bin/awesome-codex-pets.js",
    "codex-pets": "./bin/awesome-codex-pets.js"
  },
  "files": [
    "assets/previews",
    "!assets/previews/**/contact-sheet.png",
    "bin",
    "catalog",
    "docs",
    "pets",
    "schema",
    "scripts",
    "src",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "scripts": {
    "catalog:sync": "node ./scripts/sync-catalog.js",
    "list": "node ./bin/awesome-codex-pets.js list",
    "validate": "node ./scripts/validate-catalog.js",
    "previews": "node ./scripts/generate-preview-gifs.js",
    "readme": "node ./scripts/update-readme-preview.js",
    "build": "npm run catalog:sync && npm run validate && npm run readme"
  },
  "keywords": [
    "codex",
    "codex-pets",
    "pets",
    "spritesheet",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HuaqingAI/awesome-codex-pets"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "gifenc": "^1.0.3"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  }
}
